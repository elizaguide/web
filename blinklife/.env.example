# BlinkLife Environment Configuration
# Copy this file to .env and fill in your actual keys

# ===========================================
# DATABASE (SUPABASE) 
# ===========================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# AI PROVIDERS
# ===========================================
# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id_here

# Anthropic API Configuration  
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_here

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Email Service (Optional)
SENDGRID_API_KEY=your_sendgrid_key_here
FROM_EMAIL=support@blinklife.com

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=your_ga_id_here

# ===========================================
# SECURITY
# ===========================================
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_AI_COACHING=true
ENABLE_ANALYTICS=true
ENABLE_COMMUNITY=false
ENABLE_NOTIFICATIONS=true

# ===========================================
# NOTES FOR STEVEN
# ===========================================
# Steven - Please get API keys from Norman for:
# 1. OpenAI API access (for AI coaching features)
# 2. Anthropic Claude API access (for consciousness analysis)
# 3. Set up Supabase project and get connection details
# 
# After getting keys, copy this file to .env and fill in the values
# Do NOT commit the actual .env file to git (it's in .gitignore)